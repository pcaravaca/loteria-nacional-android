<resources>
    <style name="Theme.Lotto" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lot_accent</item>
        <item name="colorOnPrimary">#1A1405</item>
        <item name="colorSecondary">@color/lot_gold_light</item>
        <item name="colorOnSecondary">#1A1405</item>
        <item name="android:windowBackground">@color/lot_bg</item>
        <item name="android:statusBarColor">@color/lot_bg</item>
        <item name="android:navigationBarColor">@color/lot_bg</item>
        <item name="android:textColorPrimary">@color/lot_text</item>
        <item name="android:textColorSecondary">@color/lot_text_muted</item>
    </style>

    <style name="LottoCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/lot_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/lot_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">0dp</item>
    </style>
</resources>
